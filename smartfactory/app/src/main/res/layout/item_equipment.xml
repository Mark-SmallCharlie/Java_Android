<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Equipment image -->
        <ImageView
            android:id="@+id/iv_equipment"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/input_background"
            android:contentDescription="@string/tab_production"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_equipment" />

        <!-- Equipment info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="CNC数控车床" />

            <TextView
                android:id="@+id/tv_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="PRD-001" />

            <!-- Damage level badge -->
            <TextView
                android:id="@+id/tv_damage_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_damage_badge"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="良好"
                tools:backgroundTint="@color/damage_good" />

        </LinearLayout>

        <!-- Arrow indicator -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/equipment_detail"
            android:src="@android:drawable/ic_media_play"
            android:tint="@color/text_hint" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
